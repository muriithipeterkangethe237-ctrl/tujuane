rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for UserProfile
    function isValidUserProfile(data) {
      return data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100
        && (!('email' in data) || (data.email is string && data.email.size() <= 128))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 600000))
        && (!('county' in data) || (data.county is string && data.county.size() <= 50))
        && (!('constituency' in data) || (data.constituency is string && data.constituency.size() <= 60))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 500))
        && (!('occupation' in data) || (data.occupation is string && data.occupation.size() <= 100))
        && (!('isOnline' in data) || data.isOnline is bool)
        && (!('lastSeen' in data) || data.lastSeen is timestamp || data.lastSeen is string)
        && (!('blockedUserIds' in data) || (data.blockedUserIds is list && data.blockedUserIds.size() <= 500))
        && (!('mutedUserIds' in data) || (data.mutedUserIds is list && data.mutedUserIds.size() <= 500))
        && (!('createdAt' in data) || data.createdAt is timestamp || data.createdAt is string);
    }


    // Validation for ChatConversation
    function isValidChatConversation(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 256
        && data.participants is list && data.participants.size() == 2
        && data.participants[0] is string && data.participants[1] is string
        && data.createdAt is timestamp
        && (!('lastMessage' in data) || (data.lastMessage is string && data.lastMessage.size() <= 500))
        && (!('lastMessageSenderId' in data) || (data.lastMessageSenderId is string && data.lastMessageSenderId.size() <= 128))
        && (!('lastMessageTimestamp' in data) || data.lastMessageTimestamp is timestamp)
        && (!('participantDetails' in data) || data.participantDetails is map)
        && (!('typingUsers' in data) || data.typingUsers is map);
    }

    // Validation for ChatMessage
    function isValidChatMessage(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.chatId is string && data.chatId.size() > 0 && data.chatId.size() <= 256
        && data.senderId is string && data.senderId == request.auth.uid
        && data.recipientId is string && data.recipientId.size() > 0 && data.recipientId.size() <= 128
        && data.text is string && data.text.size() <= 1000
        && (!('mediaUrl' in data) || (data.mediaUrl is string && data.mediaUrl.size() <= 600000))
        && (!('attachment' in data) || data.attachment is map)
        && (!('replyTo' in data) || data.replyTo is map)
        && (!('status' in data) || (data.status is string && data.status.size() <= 20))
        && (!('readBy' in data) || data.readBy is list)
        && (!('deliveredTo' in data) || data.deliveredTo is list)
        && (!('isEdited' in data) || data.isEdited is bool)
        && (!('editedAt' in data) || data.editedAt is timestamp)
        && (!('isDeletedForEveryone' in data) || data.isDeletedForEveryone is bool)
        && (!('deletedForUsers' in data) || data.deletedForUsers is list)
        && (!('senderName' in data) || (data.senderName is string && data.senderName.size() <= 100))
        && (!('senderPhoto' in data) || (data.senderPhoto is string && data.senderPhoto.size() <= 500))
        && (!('hotspotReference' in data) || data.hotspotReference is map)
        && data.createdAt is timestamp;
    }

    // Validation for CommunityPost
    function isValidCommunityPost(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.authorId is string && data.authorId == request.auth.uid
        && data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 100
        && (!('authorPhotoUrl' in data) || (data.authorPhotoUrl is string && data.authorPhotoUrl.size() <= 500))
        && (!('authorCounty' in data) || (data.authorCounty is string && data.authorCounty.size() <= 50))
        && data.title is string && data.title.size() > 0 && data.title.size() <= 150
        && data.content is string && data.content.size() > 0 && data.content.size() <= 2000
        && data.category in ['general', 'discussion', 'hustle', 'local_news', 'meetup', 'campus', 'question', 'speed_report', 'hotspot_tip', 'outage_alert']
        && data.county is string && data.county.size() <= 50
        && (!('constituency' in data) || (data.constituency is string && data.constituency.size() <= 60))
        && (!('mediaUrl' in data) || (data.mediaUrl is string && data.mediaUrl.size() <= 600000))
        && (!('mediaCaption' in data) || (data.mediaCaption is string && data.mediaCaption.size() <= 200))
        && (!('isFlagged' in data) || data.isFlagged is bool)
        && (!('safetyCategory' in data) || (data.safetyCategory is string && data.safetyCategory.size() <= 40))
        && (!('safetyReason' in data) || (data.safetyReason is string && data.safetyReason.size() <= 300))
        && (!('safetyAdvisory' in data) || (data.safetyAdvisory is string && data.safetyAdvisory.size() <= 300))
        && (!('moderationStatus' in data) || (data.moderationStatus is string && data.moderationStatus.size() <= 30))
        && (!('reportCount' in data) || data.reportCount is int)
        && data.createdAt is timestamp;
    }

    // Validation for CommunityComment
    function isValidCommunityComment(data, postId) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.postId == postId
        && data.authorId is string && data.authorId == request.auth.uid
        && data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 100
        && (!('authorPhotoUrl' in data) || (data.authorPhotoUrl is string && data.authorPhotoUrl.size() <= 500))
        && data.content is string && data.content.size() > 0 && data.content.size() <= 1000
        && (!('mediaUrl' in data) || (data.mediaUrl is string && data.mediaUrl.size() <= 600000))
        && (!('replyToCommentId' in data) || (data.replyToCommentId is string && data.replyToCommentId.size() <= 128))
        && (!('replyToAuthorName' in data) || (data.replyToAuthorName is string && data.replyToAuthorName.size() <= 100))
        && data.createdAt is timestamp;
    }

    // Validation for CommunityPoll
    function isValidCommunityPoll(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && (!('description' in data) || (data.description is string && data.description.size() <= 1000))
        && data.category in ['culture', 'community', 'lifestyle', 'governance', 'food', 'sports']
        && (!('countyScope' in data) || (data.countyScope is string && data.countyScope.size() <= 60))
        && data.options is list && data.options.size() >= 2 && data.options.size() <= 8
        && data.totalVotes is int && data.totalVotes >= 0
        && data.isActive is bool
        && data.createdAt is timestamp;
    }

    // Validation for PollVote
    function isValidPollVote(data, pollId, userId) {
      return data.userId == userId
        && data.pollId == pollId
        && data.optionId is string && data.optionId.size() > 0 && data.optionId.size() <= 64
        && data.votedAt is timestamp;
    }

    // 1. Users collection
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() 
        && isValidId(userId) 
        && request.auth.uid == userId 
        && incoming().uid == request.auth.uid
        && isValidUserProfile(incoming());
      allow update: if isSignedIn() 
        && isValidId(userId) 
        && request.auth.uid == userId 
        && incoming().uid == existing().uid
        && isValidUserProfile(incoming());

      allow delete: if false;
    }

    // 2. Chats collection (1-on-1 conversations)
    match /chats/{chatId} {
      allow get: if isSignedIn() 
        && (resource == null || request.auth.uid in resource.data.participants);
      
      allow list: if isSignedIn() 
        && (request.auth.uid in resource.data.participants);

      allow create: if isSignedIn() 
        && isValidChatConversation(incoming())
        && (request.auth.uid in incoming().participants)
        && incoming().participants.size() == 2;

      allow update: if isSignedIn() 
        && (request.auth.uid in existing().participants);

      allow delete: if false;

      // 3. Messages subcollection
      match /messages/{messageId} {
        allow get, list: if isSignedIn() 
          && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants);

        allow create: if isSignedIn() 
          && isValidId(messageId)
          && isValidChatMessage(incoming())
          && incoming().chatId == chatId
          && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants);

        allow update: if isSignedIn()
          && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants);

        allow delete: if false;
      }
    }

    // 4. Community Posts collection
    match /community_posts/{postId} {
      allow read: if true; // Public community reading

      allow create: if isSignedIn()
        && isValidId(postId)
        && isValidCommunityPost(incoming())
        && incoming().id == postId
        && incoming().authorId == request.auth.uid;

      allow update: if isSignedIn()
        && isValidId(postId)
        && (
          // Case 1: Post author editing
          (existing().authorId == request.auth.uid && incoming().authorId == existing().authorId && incoming().createdAt == existing().createdAt)
          ||
          // Case 2: Developer / Moderator update
          (request.auth.token.email == 'muriithipeterkangethe237@gmail.com')
          ||
          // Case 3: Community upvoting, commentsCount or moderation/safety flags
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['upvotes', 'upvoters', 'commentsCount', 'isFlagged', 'safetyCategory', 'safetyReason', 'safetyAdvisory', 'moderationStatus', 'reportCount'])
          )
        );

      allow delete: if isSignedIn()
        && isValidId(postId)
        && (existing().authorId == request.auth.uid || request.auth.token.email == 'muriithipeterkangethe237@gmail.com');

      // 5. Comments subcollection
      match /comments/{commentId} {
        allow read: if true; // Public comment reading

        allow create: if isSignedIn()
          && isValidId(commentId)
          && isValidCommunityComment(incoming(), postId);

        allow update: if false;
        allow delete: if isSignedIn()
          && isValidId(commentId)
          && (existing().authorId == request.auth.uid || request.auth.token.email == 'muriithipeterkangethe237@gmail.com');
      }
    }

    // 6. Community Polls collection
    match /community_polls/{pollId} {
      allow read: if true; // Anyone can view active polls and results

      allow create: if isSignedIn()
        && isValidId(pollId)
        && isValidCommunityPoll(incoming())
        && incoming().id == pollId;

      allow update: if isSignedIn()
        && isValidId(pollId)
        && (
          // Citizen casting vote: updates options array and increments totalVotes
          incoming().diff(existing()).affectedKeys().hasOnly(['options', 'totalVotes'])
          ||
          // Author updating poll parameters
          (existing().authorId == request.auth.uid && incoming().authorId == existing().authorId)
        );

      allow delete: if isSignedIn()
        && isValidId(pollId)
        && existing().authorId == request.auth.uid;

      // 7. Individual Votes subcollection
      match /votes/{userId} {
        allow read: if isSignedIn() && request.auth.uid == userId;

        allow create, update: if isSignedIn()
          && request.auth.uid == userId
          && isValidId(userId)
          && isValidPollVote(incoming(), pollId, userId);

        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // 8. Public Community Channels
    match /channels/{channelId} {
      allow read: if true;
      allow write: if isSignedIn();

      match /messages/{messageId} {
        allow read: if true;
        allow create: if isSignedIn()
          && isValidId(messageId)
          && incoming().channelId == channelId
          && incoming().senderId == request.auth.uid;
        allow update: if isSignedIn()
          && (existing().senderId == request.auth.uid || incoming().diff(existing()).affectedKeys().hasOnly(['upvotes']));
        allow delete: if isSignedIn() && existing().senderId == request.auth.uid;
      }
    }

    // 9. Community Group Chats
    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(groupId)
        && incoming().creatorId == request.auth.uid;
      allow update: if isSignedIn()
        && (
          (request.auth.uid in existing().members) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['members', 'memberDetails', 'lastMessage', 'lastMessageSenderName', 'lastMessageTimestamp'])
        );
      allow delete: if isSignedIn() && existing().creatorId == request.auth.uid;

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && isValidId(messageId)
          && incoming().senderId == request.auth.uid;
        allow update: if isSignedIn() && existing().senderId == request.auth.uid;
        allow delete: if isSignedIn() && existing().senderId == request.auth.uid;
      }
    }

    // 10. Follow Relationships
    match /follows/{followId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && incoming().followerId == request.auth.uid;
      allow delete: if isSignedIn()
        && existing().followerId == request.auth.uid;
    }

    // 11. Friend Requests
    match /friend_requests/{requestId} {
      allow read: if isSignedIn()
        && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid || request.auth.token.email == 'muriithipeterkangethe237@gmail.com');
      allow create: if isSignedIn()
        && incoming().senderId == request.auth.uid;
      allow update: if isSignedIn()
        && (existing().receiverId == request.auth.uid || existing().senderId == request.auth.uid || request.auth.token.email == 'muriithipeterkangethe237@gmail.com');
      allow delete: if isSignedIn()
        && (existing().senderId == request.auth.uid || existing().receiverId == request.auth.uid || request.auth.token.email == 'muriithipeterkangethe237@gmail.com');
    }

    // 12. Safety Reports
    match /safety_reports/{reportId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && incoming().reporterId == request.auth.uid;
      allow update, delete: if isSignedIn()
        && (resource.data.reporterId == request.auth.uid || request.auth.token.email == 'muriithipeterkangethe237@gmail.com');
    }

    // 13. Moderator Action Logs
    match /moderator_action_logs/{logId} {
      allow read: if isSignedIn() && request.auth.token.email == 'muriithipeterkangethe237@gmail.com';
      allow create: if isSignedIn();
    }

    // 14. User Notifications Channel (post interactions, account standing, social)
    match /user_notifications/{notificationId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || request.auth.token.email == 'muriithipeterkangethe237@gmail.com');
      allow create: if isSignedIn()
        && isValidId(notificationId)
        && incoming().userId is string
        && incoming().id == notificationId;
      allow update: if isSignedIn()
        && (resource.data.userId == request.auth.uid || request.auth.token.email == 'muriithipeterkangethe237@gmail.com');
      allow delete: if isSignedIn()
        && (resource.data.userId == request.auth.uid || request.auth.token.email == 'muriithipeterkangethe237@gmail.com');
    }
  }
}


